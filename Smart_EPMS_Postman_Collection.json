{
	"info": {
		"_postman_id": "epms-smart-management-v1",
		"name": "Smart Employee & Project Management System (EPMS)",
		"description": "Comprehensive Postman collection for testing all REST API endpoints of Smart EPMS including Authentication, Dashboard, Employees, Projects, Tasks, Reports, Profile, and Audit Logs.",
